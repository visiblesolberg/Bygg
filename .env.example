# === LillesandHus husmatcher – miljøvariabler (dokumentasjon) ===
# Disse brukes IKKE client-side i MVP-en. De er forberedt for et eget
# backend-/serverless-endpoint som holder API-nøkkelen hemmelig og
# snakker med SureContact på vegne av appen. Se src/lib/leads.js og README.

# Hemmelig SureContact API-nøkkel – settes KUN på backend/serverless, aldri i browseren.
SURECONTACT_API_KEY=

# Endepunktet frontend poster leads til (proxy mot SureContact).
LEAD_ENDPOINT=/api/lead
